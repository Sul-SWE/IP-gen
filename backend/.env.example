# Copy this file to ".env" (same folder) and fill it in. Never commit .env.

# --- Database (MySQL / MariaDB). Create the database first:  CREATE DATABASE ipgen CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://ipgen_user:CHANGE_ME@localhost:3306/ipgen?charset=utf8mb4
# Quick trial without MySQL (a local file):
# DATABASE_URL=sqlite:///ipgen.db

# --- Admin account, created on the FIRST run only. Use a password of 8+ characters and change it afterwards in Settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Server
HOST=127.0.0.1
PORT=8000

# --- Sessions
SESSION_HOURS=8             # admin is signed out after this many hours without activity
ADMIN_IDLE_MINUTES=5        # another admin may sign in without "take over" when the current one is idle this long
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MINUTES=15
COOKIE_SECURE=false         # set true when the site is served over HTTPS

# --- Viewer (no sign-in): may the viewer open the Worksheet?
VIEWER_CAN_SEE_WORKSHEET=true

# --- Leave empty: the frontend is served by this same server (same origin).
ALLOWED_ORIGINS=
